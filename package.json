{
  "name": "actual-assistant-engineer",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "assistant-engineer": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:bridge": "uv run --python 3.11 --with pytest python -m pytest -q test/bridge",
    "test:live": "bun test test/integration",
    "build:native": "uv run --no-project --python 3.11 python scripts/developer.py build-native",
    "install:live": "uv run --no-project --python 3.11 python scripts/developer.py install-live",
    "install:hermes": "uv run --no-project --python 3.11 python scripts/developer.py install-hermes",
    "song": "bun run spike/run-song.ts",
    "test:engine": "uv run --python 3.11 --with pytest python -m pytest -q test/engine"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
